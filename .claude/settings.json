{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_render.py\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_subagente.py\""
          }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_entrega.py\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": false
  },
  "permissions": {
    "deny": [
      "Skill(graphify)",
      "Skill(style-sampling)",
      "Skill(anthropic-skills:docx)",
      "Skill(anthropic-skills:pdf)",
      "Skill(anthropic-skills:xlsx)",
      "Skill(anthropic-skills:pptx)",
      "Skill(anthropic-skills:docs)",
      "Skill(anthropic-skills:deep-research)",
      "Skill(anthropic-skills:morning)",
      "Skill(anthropic-skills:setup-claude)",
      "Skill(anthropic-skills:setup-writing-style)",
      "Skill(anthropic-skills:skill-creator)",
      "Skill(anthropic-skills:import-memory)",
      "Skill(anthropic-skills:consolidate-memory)",
      "Skill(anthropic-skills:explain-usage)",
      "Skill(anthropic-skills:computer-use)"
    ]
  }
}