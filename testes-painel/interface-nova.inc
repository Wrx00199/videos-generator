/* Multi-conta: só ações manuais. */
let contasLista=[],contaAtual='six_stars',trocaVersao=0;
try{contaAtual=localStorage.getItem('painel-conta')||contaAtual}catch{}
const urlConta=p=>`${p}?conta=${encodeURIComponent(contaAtual)}`;
const atualConta=()=>contasLista.find(c=>c.id===contaAtual);
const uploads={youtube:'https://studio.youtube.com/',tiktok:'https://www.tiktok.com/tiktokstudio/upload',instagram:'https://business.facebook.com/latest/content_calendar',facebook:'https://business.facebook.com/latest/content_calendar'};
async function requisitar(url,body){const r=await fetch(url,body===undefined?{}:{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json();if(!r.ok)throw new Error(j.erro||'Erro ao carregar');return j;}
function mensagem(s){$('#aviso-global').textContent=s;}
function acao(fn){return async e=>{try{await fn(e)}catch(err){mensagem(err.message)}};}
function sidebar(aberta){document.body.classList.toggle('sb-fechada',!aberta);$('#sb').classList.toggle('aberta',aberta);$('#menu').classList.toggle('ativo',aberta);$('#menu').setAttribute('aria-expanded',String(aberta));}
$('#menu').onclick=()=>sidebar($('#menu').getAttribute('aria-expanded')!=='true');
$('#fechar-menu').onclick=()=>sidebar(false);
sidebar(!matchMedia('(max-width:820px)').matches);
$('#configurar').onclick=()=>ir('config');
async function carregarLista(){contasLista=await requisitar('/api/contas-cfg');if(!contasLista.some(c=>c.id===contaAtual))contaAtual=contasLista[0]?.id||'';$('#seletor-conta').innerHTML=contasLista.map(c=>`<option value="${esc(c.id)}">${esc(c.nome)} · ${esc(c.nicho)}</option>`).join('');$('#seletor-conta').value=contaAtual;$('#editor-selecao').innerHTML='<option value="">Nova conta</option>'+contasLista.map(c=>`<option value="${esc(c.id)}">${esc(c.nome)}</option>`).join('');}
async function trocarConta(){trocaVersao++;rev=null;vistos=null;try{localStorage.setItem('painel-conta',contaAtual)}catch{}if(!contaAtual){$('#clipes').innerHTML='Cadastre uma conta em ⚙ Configurações.';return;}await Promise.all([carregarRev(),carregarPlacar(),carregarCalendario()]);}
$('#seletor-conta').onchange=acao(async e=>{contaAtual=e.target.value;await trocarConta()});
// Substitui os leitores antigos, preservando cards, player e atalhos.
carregarRev=async function(){if(!contaAtual)return;const c=contaAtual,v=trocaVersao;try{const r=await requisitar(urlConta('/api/revisao'));if(c!==contaAtual||v!==trocaVersao)return;const mudou=!rev||JSON.stringify(r.itens)!==JSON.stringify(rev.itens);rev=r;$('#n-rev').textContent=r.contagem.revisao;for(const k in r.contagem)$('#c-'+k).textContent=r.contagem[k];desenharPipe(r);if(mudou&&!document.activeElement.matches('.legenda-video'))desenharRev();}catch(e){mensagem(e.message)}};
const cardAntigo=cardClipe;
cardClipe=function(i,novos=[]){let html=cardAntigo(i,novos);const links=(atualConta()?.plataformas||[]).filter(p=>p.ligado).map(p=>`<a class="chip" target="_blank" rel="noopener noreferrer" href="${uploads[p.rede]}">Upload ${esc(p.rede)} ↗</a>`).join(' ');return html.replace(`<div class="tt">${esc(i.legenda)}</div>`,`<label for="leg-${i.id}">Legenda editável</label><textarea class="legenda-video" id="leg-${i.id}" data-original="${esc(i.legenda)}">${esc(i.legenda)}</textarea><div class="acts"><button class="chip" data-leg="salvar">Salvar legenda</button><button class="chip" data-leg="copiar">Copiar</button></div><div class="uploads">${links||'<span class="mut">Nenhuma rede ligada</span>'}</div>`);};
async function salvarLegenda(card){const t=card.querySelector('textarea');await requisitar('/api/legendas',{conta:contaAtual,id:card.dataset.id,legenda:t.value});t.dataset.original=t.value;const item=rev?.itens.find(i=>i.id===card.dataset.id);if(item)item.legenda=t.value;}
async function cliqueRevisao(e){const card=e.target.closest('.card');if(!card)return;const l=e.target.closest('[data-leg]');if(l){if(l.dataset.leg==='salvar'){await salvarLegenda(card);mensagem('Legenda salva ✓')}else{const texto=card.querySelector('textarea').value;try{await navigator.clipboard.writeText(texto);mensagem('Legenda copiada ✓')}catch{card.querySelector('textarea').select();mensagem('Selecione e copie a legenda.')}}return;}
 const b=e.target.closest('[data-d]');if(!b)return;let motivo='';if(b.dataset.d==='recusado'){motivo=prompt('Motivo da recusa (opcional)');if(motivo===null)return;}
 b.disabled=true;try{await salvarLegenda(card);await requisitar('/api/decidir',{conta:contaAtual,id:card.dataset.id,estado:b.dataset.d,motivo});rev=null;await carregarRev();await carregarCalendario();await carregarPlacar();mensagem('Decisão salva. Publicação continua manual.')}finally{b.disabled=false;}
}
$('#clipes').onclick=acao(cliqueRevisao);$('#l-clipes').onclick=acao(cliqueRevisao);
carregarPlacar=async function(){if(!contaAtual)return;const c=contaAtual;try{const l=await requisitar(urlConta('/api/placar'));if(c!==contaAtual)return;$('#placarTab').innerHTML='<tr><th>Conta</th><th>Aprovados</th><th>Recusados</th><th>Revisão</th><th>Taxa</th></tr>'+l.map(x=>`<tr><td>${esc(x.streamer)}</td><td>${x.aprovado}</td><td>${x.recusado}</td><td>${x.revisao}</td><td>${x.taxa??'–'}%</td></tr>`).join('');}catch(e){mensagem(e.message)}};
async function carregarCalendario(){if(!contaAtual)return;const c=contaAtual;const j=await requisitar(urlConta('/api/calendario'));if(c!==contaAtual)return;$('#cal-aviso').textContent=j.faltam?`⚠ Faltou vídeo hoje: ${j.produzidos_hoje}/${j.meta_min} · faltam ${j.faltam}`:`✓ Meta mínima do dia atingida: ${j.produzidos_hoje}`;$('#cal-meta').textContent=`${atualConta()?.nome||''} · meta ${j.meta_min}${j.meta_max!==j.meta_min?'–'+j.meta_max:''}/dia · horário de Brasília · vídeos prontos por data do arquivo`;$('#cal-horarios').textContent='Horários sugeridos: '+(j.horarios.join(' · ')||'nenhum');$('#cal-dias').innerHTML=Array.from({length:14},(_,i)=>{const d=new Date(j.hoje+'T12:00:00Z');d.setUTCDate(d.getUTCDate()-13+i);const k=d.toISOString().slice(0,10),n=j.dias[k]||0;return `<div class="dia ${n>=j.meta_min?'atingida':''}"><span>${k.slice(8)}/${k.slice(5,7)}</span><b>${n}</b><small>de ${j.meta_min} vídeos</small></div>`}).join('');}
async function carregarOperacao(){const [bots,fila]=await Promise.all([requisitar('/api/bots'),requisitar('/api/render-fila')]);$('#bots').innerHTML=bots.map(b=>`<span title="${esc(b.criterio)}"><i class="sinal ${b.ativo?'verde':'vermelho'}"></i>${esc(b.bot)} · ${b.ultimo_sinal?new Date(b.ultimo_sinal).toLocaleTimeString('pt-BR'):'sem sinal'}</span>`).join('');$('#render-fila').innerHTML='<p>Leve · média · pesada — limite: 1 render pesado por vez. Lista informativa, sem iniciar trabalhos.</p>'+(fila.itens.length?fila.itens.map(x=>`<p>${esc(x.tipo)} · ${esc(x.peso)} · PID ${x.pid}</p>`).join(''):'<p class="mut">Nenhum render externo detectado.</p>');}
async function carregarConfig(){await carregarLista();const s=await requisitar('/api/saude');$('#cofre').innerHTML=s.chaves.map(c=>`<p><b>${esc(c.nome)}</b> · ${c.existe?(c.formato_valido?'presente · formato compatível':'presente · formato não reconhecido'):'ausente'}</p>`).join('')+'<p class="mut">Validade no provedor não consultada. Nenhuma chamada de IA.</p>';$('#pc-config').innerHTML=`CPU ${s.pc.carga}% · ${s.pc.nucleos} núcleos<br>RAM livre ${s.pc.ram_livre_gb}/${s.pc.ram_total_gb} GB<br>Disco livre ${s.pc.disco_livre_gb??'indisponível'} GB<br>`+(s.pc.gpus.length?s.pc.gpus.map(g=>`${esc(g.nome)}: ${g.uso_percent??'indisponível'}% · VRAM ${g.vram_usada_bytes==null?'indisponível':Math.round(g.vram_usada_bytes/1048576)+' MB'}/${g.vram_total_bytes==null?'?':Math.round(g.vram_total_bytes/1048576)+' MB'}`).join('<br>'):'GPU: sensores indisponíveis');await carregarRede();}
async function carregarRede(){try{const r=await requisitar('/api/rede');$('#rede-status').textContent=r.ligado?'Ligado · '+r.urls.join(' · '):'Desligado · só neste PC';$('#rede-aviso').textContent=r.aviso;}catch(e){$('#rede-status').textContent=e.message;}}
$('#rede-on').onclick=acao(async()=>{await requisitar('/api/rede',{ligado:true,senha:$('#rede-senha').value});$('#rede-senha').value='';await carregarRede()});
$('#rede-off').onclick=acao(async()=>{await requisitar('/api/rede',{ligado:false});await carregarRede()});
function editor(c){$('#ed-id').value=c?.id||'';$('#ed-id').readOnly=!!c;for(const k of ['nome','nicho','pasta_saida','legenda_modelo','tipo_producao'])$('#ed-'+k).value=c?.[k]||'';$('#ed-horarios').value=c?.horarios.join(', ')||'';$('#ed-filtro').checked=c?.filtro_acabamento??true;$('#ed-plataformas').innerHTML=['instagram','facebook','tiktok','youtube'].map(rede=>{const p=c?.plataformas.find(p=>p.rede===rede);return `<div class="plataforma" data-rede="${rede}"><label><input type="checkbox" class="p-ligado" ${p?.ligado?'checked':''}> ${rede}</label><input aria-label="Handle ${rede}" type="text" class="p-handle" placeholder="handle" value="${esc(p?.handle||'')}"><select class="p-modo" aria-label="Modo ${rede}">${['manual','chrome','api'].map(m=>`<option ${m===(p?.modo||'manual')?'selected':''}>${m}</option>`).join('')}</select></div>`}).join('');}
$('#editor-selecao').onchange=e=>editor(contasLista.find(c=>c.id===e.target.value));
$('#conta-form').onsubmit=acao(async e=>{e.preventDefault();const c={id:$('#ed-id').value.trim(),horarios:$('#ed-horarios').value.split(',').map(x=>x.trim()).filter(Boolean),filtro_acabamento:$('#ed-filtro').checked,plataformas:$$('#ed-plataformas .plataforma').filter(el=>el.querySelector('.p-handle').value.trim()||el.querySelector('.p-ligado').checked).map(el=>({rede:el.dataset.rede,handle:el.querySelector('.p-handle').value.trim().replace(/^@/,''),ligado:el.querySelector('.p-ligado').checked,modo:el.querySelector('.p-modo').value}))};for(const k of ['nome','nicho','pasta_saida','legenda_modelo','tipo_producao'])c[k]=$('#ed-'+k).value;await requisitar('/api/contas-cfg',c);contaAtual=c.id;await carregarLista();$('#editor-selecao').value=c.id;editor(c);await trocarConta();mensagem('Conta salva ✓')});
$('#conta-remover').onclick=acao(async()=>{const id=$('#editor-selecao').value;if(!id)throw new Error('Selecione uma conta existente');if(!confirm('Remover a conta do cadastro? Os vídeos serão preservados.'))return;await requisitar('/api/contas-cfg',{acao:'remover',id});await carregarLista();editor();await trocarConta();mensagem('Conta removida do cadastro; arquivos preservados.')});
$('#referencia-form').onsubmit=acao(async e=>{e.preventDefault();await requisitar('/api/referencias',{url:$('#ref-url').value,nota:$('#ref-nota').value,conta:contaAtual});$('#ref-url').value='';$('#ref-nota').value='';mensagem('Referência pendente salva. Nenhum download iniciado.')});
carga.config=carregarConfig;carga.calendario=carregarCalendario;carga.operacao=carregarOperacao;
editor();
(async()=>{try{await carregarLista();await trocarConta();await carregarOperacao();await carregarSaude();ir('rev');}catch(e){mensagem(e.message)}})();
setInterval(()=>{if(document.hidden)return;carregarOperacao().catch(e=>mensagem(e.message));carregarSaude();if(tab==='rev')carregarRev();if(tab==='calendario')carregarCalendario().catch(e=>mensagem(e.message));if(tab==='placar')carregarPlacar();},30000);
